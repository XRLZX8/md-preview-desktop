{
  "name": "md-preview-desktop",
  "version": "0.1.0",
  "description": "A Markdown preview desktop app with history tracking",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "publish": "electron-builder --win --publish always"
  },
  "author": "Helios",
  "license": "MIT",
  "build": {
    "appId": "com.helios.md-preview",
    "productName": "MD Preview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "XRLZX8",
      "repo": "md-preview-desktop"
    }
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.0.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  }
}