{
  "name": "md-preview-desktop",
  "version": "0.1.0",
  "description": "A Markdown preview desktop app with history tracking",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "publish": "electron-builder --win --publish always"
  },
  "author": "Helios",
  "license": "MIT",
  "build": {
    "appId": "com.helios.md-preview",
    "productName": "MD Preview",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "Helios",
      "repo": "md-preview-desktop"
    }
  }
}